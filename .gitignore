# Obsidian: this repo opens as a vault. Keep its settings, ignore its state.
.obsidian/workspace*.json
.obsidian/bojubot/
.obsidian/plugins/*/main.js
.obsidian/plugins/*/manifest.json
.obsidian/plugins/*/styles.css
.obsidian/plugins/bojubot/obsidian-commands.md
.obsidian/plugins/obsidian-git/obsidian_askpass.sh
.bojubot/*
node_modules/
main.js
_bojubot-debug.log
# Generated at runtime when plugin dev folder is opened directly as a vault
/obsidian-commands.md
/commands.md
bojubot-debug.log
# Pasted images saved by BojuBot clipboard paste feature
tmp/

# Plugin settings written through the test vaults' junction to the repo root (machine-specific)
/data.json

# Claude Code — machine-specific and runtime files
.claude/settings.local.json
.claude/settings.json
# BojuBot runtime data written when plugin runs from symlinked dev folder
# In production vaults this lives at .obsidian/plugins/bojubot/.claude/sessions/
.claude/sessions/
.claude/worktrees/

# User slash command templates (local to each install)
commands/

# TypeScript compiled output (esbuild bundles to main.js; tsc -noEmit only)
src/**/*.js
test/**/*.js

notes/COMMIT_DRAFT.md
BojuBot_Marketing/
docs/.vitepress/cache/
bojubot-debug.log
cortex-debug.log
obsidibot-debug.log
*.dead
docs/.vitepress/dist/*
